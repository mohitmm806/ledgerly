# Copy to .env. All values have sane defaults; nothing here is required to
# run locally with SQLite.

# Leave unset to use a local SQLite file (zero dependencies).
# docker-compose sets this to the Postgres service automatically.
# DATABASE_URL=postgresql+psycopg2://ledgerly:ledgerly@localhost:5432/ledgerly

# Where uploaded source files are written.
# STORAGE_DIR=./storage

# Set to false in environments without the tesseract binary installed.
# ENABLE_OCR=true

# Which model provider to use for extraction + NL query:
#   groq       - free tier, no credit card (get a key at https://console.groq.com)
#   anthropic  - Claude (pay-as-you-go)
# Without a working provider, ingestion / grounding / browsing still work; the
# extraction and query endpoints return a clear error.
# LLM_PROVIDER=groq

# Groq (free tier). Only needed when LLM_PROVIDER=groq.
# GROQ_API_KEY=gsk_...

# Anthropic. Only needed when LLM_PROVIDER=anthropic.
# LLM_API_KEY=sk-ant-...

# Override the model for the chosen provider. Defaults: groq ->
# llama-3.3-70b-versatile, anthropic -> claude-haiku-4-5-20251001.
# LLM_MODEL=
